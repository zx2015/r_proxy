# 与构建无关的元数据
# 注意：README.md 不能排除——pyproject.toml 的 readme = "README.md" 使
# `pip install .` 依赖它，Dockerfile 也显式 COPY 了它；排除会导致构建失败
# （COPY 找不到文件），这里曾经踩过。
.git/
.gitignore
.cursor/
.learnings/
.claude/settings.local.json
TODO.md

# 构建/测试缓存（绝不会进入镜像，但排除能减小构建上下文）
build/
dist/
.eggs/
*.egg-info/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# 非运行所需文档/研究资料（Dockerfile 只 COPY 源码与 pyproject）
docs/
study/
experience/

# 运行时产物
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
logs/

# 编辑器/系统垃圾
.idea/
.vscode/
.DS_Store
*.swp

# 本地部署覆盖
deploy/config.local.toml
.env
.env.*
